# Parla Mente — environment configuration (copy to .env)

# Storage
PARLAMENTE_DB_PATH=data/db/parlamente.duckdb
PARLAMENTE_DATA_DIR=data

# Camera dei Deputati open data
PARLAMENTE_CAMERA_SPARQL_ENDPOINT=https://dati.camera.it/sparql
PARLAMENTE_CAMERA_BASE_URL=https://www.camera.it

# HTTP client politeness (rispetto fonti ufficiali / robots / rate-limit)
PARLAMENTE_HTTP_TIMEOUT=60
PARLAMENTE_HTTP_RATE_LIMIT_SECONDS=1.0
PARLAMENTE_USER_AGENT=ParlaMente/0.1 (civic-tech; +https://github.com/nmaiese/wordspread)

# Logging
PARLAMENTE_LOG_LEVEL=INFO
